# MongoDB Atlas connection string. Use a least-privilege database user.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=codeloom

# Use a cryptographically random value of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional: a self-hosted Piston endpoint for language execution.
# PISTON_API_URL=https://emkc.org/api/v2/piston

# Vercel sets this for Cron invocations. Set it manually for local cron testing.
CRON_SECRET=replace-with-a-long-random-secret
